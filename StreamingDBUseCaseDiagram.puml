@startuml
left to right direction

actor "Користувач" as User
actor "Платіжна система" as PaymentSystem
actor "Адміністратор" as Admin

rectangle "StreamingDB System" {
  (Зареєструватися) as UC1
  (Увійти в систему) as UC2
  (Переглядати фільми) as UC3
  (Переглядати історію переглядів) as UC4
  (Створити профіль) as UC5
  (Оплатити підписку) as UC6
  (Отримати рекомендації) as UC7
  (Додати фільм у каталог) as UC8
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7

UC6 --> PaymentSystem : include
Admin --> UC8

UC3 .> UC4 : extend
UC3 .> UC7 : include
@enduml
