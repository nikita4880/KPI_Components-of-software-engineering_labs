@startuml
actor User
participant "StreamingDB System" as StreamingDB
participant "PaymentService" as PaymentService
participant "PaymentSystem" as ExternalPayment

User -> StreamingDB : selectSubscription(plan)
activate StreamingDB

StreamingDB -> PaymentService : processPayment(userId, plan)
activate PaymentService

PaymentService -> ExternalPayment : initiatePayment(amount, cardData)
activate ExternalPayment

ExternalPayment --> PaymentService : paymentResult(SUCCESS or FAILED)
deactivate ExternalPayment

alt payment success
    PaymentService -> StreamingDB : updateSubscriptionStatus(userId, "active")
    activate StreamingDB
    StreamingDB --> PaymentService : OK
    deactivate StreamingDB
    PaymentService --> User : showSuccessMessage("Підписка активована")
else payment failed
    PaymentService -> StreamingDB : updateSubscriptionStatus(userId, "failed")
    activate StreamingDB
    StreamingDB --> PaymentService : OK
    deactivate StreamingDB
    PaymentService --> User : showErrorMessage("Оплата не вдалася")
end

deactivate PaymentService
deactivate StreamingDB
@enduml

